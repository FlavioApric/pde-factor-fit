== (a) u=1+x^(N+2)e^{x^2}, N=3 (Ann=(tau); tasso non uniforme: uscita giusta solo da K>=N+3)
  K= 2 -> (1, 2, 1)
  K= 3 -> (1, 2, 1)
  K= 4 -> (1, 2, 1)
  K= 5 -> (1, 1, tau)
  K= 6 -> (1, 1, tau)
  K= 7 -> (1, 1, tau)
  K= 8 -> (1, 1, tau)
== (b) u=(t+1)/((t+1)^2+x^2) armonica (attesa tau^2+xi^2)
  K= 3 -> (2, 3, 1)
  K= 5 -> (2, 1, tau**2 + xi**2)
  K= 7 -> (2, 1, tau**2 + xi**2)
  K= 9 -> (2, 1, tau**2 + xi**2)
== (c) calore, 3 modi sum e^{-k^2 t}cos(kx) (attesa tau-xi^2 come elemento di grado minimo)
  K= 4 -> (2, 1, tau - xi**2)
  K= 6 -> (2, 1, tau - xi**2)
  K= 8 -> (2, 1, tau - xi**2)
  K=10 -> (2, 1, tau - xi**2)
== (d) u=exp(t^2+x^2), Ann=0 (atteso: nessun Q di grado <=3, grado minimo -> infinito)
  K= 6 -> (None, 0, 'nessun Q di grado <= 3')
  K= 8 -> (None, 0, 'nessun Q di grado <= 3')
  K=10 -> (None, 0, 'nessun Q di grado <= 3')
