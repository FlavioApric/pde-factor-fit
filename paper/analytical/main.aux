\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Characteristic solution of the inviscid flow of $-uu_x$. At $s=1$ the profile has a vertical tangent: the gradient blows up. Beyond that the curve folds; the physical (entropy) solution replaces the fold by a jump at $x=\pi $ (equal-area rule), shown dashed. This breaking is what makes $E_{\mathrm  {int}}$ discontinuous after the shock.}}{22}{figure.8}\protected@file@percent }
\newlabel{fig:burgers}{{8}{22}{Characteristic solution of the inviscid flow of $-uu_x$. At $s=1$ the profile has a vertical tangent: the gradient blows up. Beyond that the curve folds; the physical (entropy) solution replaces the fold by a jump at $x=\pi $ (equal-area rule), shown dashed. This breaking is what makes $\Eint $ discontinuous after the shock}{figure.8}{}}
\newlabel{fig:burgers@cref}{{[figure][8][]8}{[1][22][]22}}
\@writefile{toc}{\contentsline {paragraph}{Before the shock ($t<t^*$): smooth regime.}{22}{section*.11}\protected@file@percent }
