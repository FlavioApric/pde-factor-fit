    (1)*dt^0dx^2(u^1) + (-1)*dt^2dx^0(u^1)
    (1)*dt^0dx^0(u^1) + (-1)*dt^0dx^1(u^1) + (1/2)*dt^0dx^0(u^2)
    (1)*dt^0dx^1(u^1) + (-1)*dt^0dx^2(u^1) + (1/2)*dt^0dx^1(u^2)
